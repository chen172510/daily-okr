{
  "name": "xingxing-desktop-pet",
  "version": "1.0.0",
  "description": "行醒桌宠 · 周星星 —— Windows 桌面宠物（透明置顶小人，会走动、可拖动、能换配件）",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dist": "electron-builder --win portable"
  },
  "devDependencies": {
    "electron": "^31.3.1",
    "electron-builder": "^24.13.3"
  },
  "build": {
    "appId": "com.xingxing.desktop-pet",
    "productName": "周星星",
    "files": ["main.js", "preload.js", "index.html", "pet.js", "assets/**/*"],
    "win": { "target": ["portable"], "artifactName": "周星星-桌宠-${version}.exe" }
  }
}
